From: local
Subject: daemon: do not complete a failed OpenSession request

Secret Service clients can disconnect after their method call reaches the
message filter but before its handler runs.  The NameOwnerChanged handler then
removes the per-client PKCS#11 session.  Session negotiation returns FALSE in
that case without setting GError, but service_method_open_session ignored the
return value and attempted to construct a successful reply from NULL output
and result values.  GLib treats that invalid GVariant as fatal and aborts the
whole keyring daemon.

Return a regular D-Bus error for any negotiation failure which did not already
provide a more specific error.  A disconnected caller cannot consume the
reply, while other clients and the unlocked keyring remain alive.

--- a/daemon/dbus/gkd-secret-service.c
+++ b/daemon/dbus/gkd-secret-service.c
@@ -417,6 +417,7 @@ service_method_open_session (GkdExportedService *skeleton,
 {
 	GkdSecretSession *session;
 	GVariant *output = NULL;
+	gboolean opened;
 	gchar *result = NULL;
 	GError *error = NULL;
 	const gchar *caller;
@@ -423,15 +424,25 @@ service_method_open_session (GkdExportedService *skeleton,
 	const gchar *caller;
 	GVariant *input_payload;
 
 	caller = g_dbus_method_invocation_get_sender (invocation);
+	if (!g_hash_table_contains (self->clients, caller)) {
+		g_dbus_method_invocation_return_error_literal (invocation, G_DBUS_ERROR,
+						       G_DBUS_ERROR_FAILED,
+						       "Secret Service client disconnected");
+		return TRUE;
+	}
 
 	/* Now we can create a session with this information */
 	session = gkd_secret_session_new (self, caller);
 	input_payload = g_variant_get_variant (input);
-	gkd_secret_session_handle_open (session, algorithm, input_payload,
-					&output, &result,
-					&error);
+	opened = gkd_secret_session_handle_open (session, algorithm, input_payload,
+						 &output, &result,
+						 &error);
 	g_variant_unref (input_payload);
+	if (!opened && error == NULL)
+		g_set_error_literal (&error, G_DBUS_ERROR,
+				     G_DBUS_ERROR_FAILED,
+				     "Failed to open Secret Service session");
 
 	if (error != NULL) {
 		g_dbus_method_invocation_take_error (invocation, error);
